{
  "name": "logcadence",
  "productName": "Logcadence",
  "private": true,
  "version": "0.2.0",
  "description": "A journaling knowledge base: canvas, journal and tags panes",
  "author": "IP",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "dev:electron": "tsx scripts/build-electron.ts && tsx scripts/dev-electron.ts",
    "build": "tsc --noEmit && vite build",
    "build:electron": "pnpm build && tsx scripts/build-electron.ts",
    "dist:win": "pnpm build:electron && electron-builder --win --publish never",
    "preview": "tsx scripts/preview.ts",
    "release": "tsx scripts/release.ts",
    "release:dev": "tsx scripts/release.ts --dev",
    "start": "NODE_ENV=production tsx server/index.ts",
    "db:generate": "drizzle-kit generate --config drizzle.content.config.ts && drizzle-kit generate --config drizzle.events.config.ts",
    "seed": "tsx scripts/seed.ts",
    "export:data": "tsx scripts/export-data.ts",
    "import:data": "tsx scripts/import-data.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "electron-updater": "^6.8.9",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "~0.28.2",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
